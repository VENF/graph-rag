    "build-graph": "npx tsx src/modules/builder/index.ts",
    "search": "npx tsx src/modules/search/index.ts",
    "embed-nodes": "npx tsx scripts/embed-nodes.ts",
    "clear-vectors": "npx tsx scripts/clear-vectors.ts",
    "regtech-suite": "npx tsx scripts/regtech-suite.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@fastify/cors": "^11.2.0",
    "@langchain/core": "^1.1.48",
