{
  "name": "agentic-rag",
  "version": "1.0.0",
  "description": "Pipeline para construir un grafo de conocimiento en Markdown desde documentos jurídicos (arancel de aduanas)",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "npx tsx src/server/index.ts",
    "dev": "npx tsx --watch src/server/index.ts",
    "build-graph": "npx tsx src/modules/builder/index.ts",
    "search": "npx tsx src/modules/search/index.ts",
    "search:repl": "npx tsx src/modules/search/index.ts --repl"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.80",
    "@fastify/cors": "^11.2.0",
    "ai": "^6.0.197",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
