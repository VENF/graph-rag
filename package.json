    "@langchain/langgraph": "^1.4.1",
    "@langchain/neo4j": "^0.1.6",
    "@langchain/ollama": "^1.2.7",
    "@langchain/openai": "^1.4.7",
    "@langchain/openrouter": "^0.3.0",
    "ai": "^6.0.197",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "glob": "^11.0.0",
    "js-yaml": "^4.1.0",
    "neo4j-driver": "^6.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
